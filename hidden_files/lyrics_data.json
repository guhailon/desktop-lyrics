[
 {
  "title": "The Truth That You Leave",
  "artist": "Pianoboy · 高至豪",
  "kind": "mood",
  "lines": [
   {
    "zh": "你留下的真相",
    "dur": 5.2
   },
   {
    "zh": "像雨，落在安静的琴键上",
    "dur": 5.2
   },
   {
    "zh": "每一个你未弹出的音符",
    "dur": 5.0
   },
   {
    "zh": "仍在林间轻轻回响",
    "dur": 5.0
   },
   {
    "zh": "我在水面上描摹你的名字",
    "dur": 5.2
   },
   {
    "zh": "涟漪却将它缓缓带走",
    "dur": 5.0
   },
   {
    "zh": "若告别是你欠我的全部",
    "dur": 5.2
   },
   {
    "zh": "请留得温柔，留得真实",
    "dur": 5.0
   },
   {
    "zh": "你留在身后的真相",
    "dur": 5.2
   },
   {
    "zh": "是我为你留存的歌",
    "dur": 5.6
   }
  ]
 },
